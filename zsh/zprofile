# ~/.zprofile: executed by zsh(1) for login shells.

# include user's private bin in PATH
if [ -d "$HOME/bin" ]; then
  export PATH="$HOME/bin:$PATH"
fi

if [ -d "$HOME/.local/bin" ]; then
  export PATH="$HOME/.local/bin:$PATH"
fi

# Hyprland on the Intel GPU only: Lenovo's Hybrid-Auto mode pulls the NVIDIA GPU when the charger is
# unplugged, and a compositor holding it then crashes. HDMI/DP are wired to the NVIDIA GPU, so keep it
# if an external screen is connected at login (unplugging during that session would still be unsafe).
if [ -z "${AQ_DRM_DEVICES:-}" ] && [ -e /dev/dri/by-path/pci-0000:00:02.0-card ]; then
  _external=0
  for _s in /sys/class/drm/*/status; do # always matches (eDP), so no zsh "no matches" error
    case "$_s" in */card*-HDMI-*|*/card*-DP-*) [ "$(cat "$_s" 2>/dev/null)" = connected ] && _external=1 ;; esac
  done
  if [ "$_external" = 0 ]; then
    export AQ_DRM_DEVICES="$(readlink -f /dev/dri/by-path/pci-0000:00:02.0-card)"
    # Also keep every app's GL/EGL/Vulkan off the NVIDIA driver: its libraries hold the GPU open inside
    # each process (Hyprland, Xwayland, browsers...), which the GPU being pulled takes down with it.
    # CUDA (PyTorch etc.) talks to the driver directly, so ML still gets the GPU whenever it's present.
    [ -f /usr/share/glvnd/egl_vendor.d/50_mesa.json ] && export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json
    export __GLX_VENDOR_LIBRARY_NAME=mesa
    export VK_LOADER_DRIVERS_DISABLE='*nvidia*'
  fi
  unset _s _external
fi
