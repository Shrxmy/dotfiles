# ~/.zshrc: executed by zsh(1) for interactive shells.

# If not running interactively, do nothing.
[[ -o interactive ]] || return

# History
HISTSIZE=1000
SAVEHIST=2000
HISTFILE="$HOME/.zsh_history"
setopt APPEND_HISTORY
setopt HIST_IGNORE_DUPS

# Completion
autoload -Uz compinit
compinit

# Shared shell setup
ZDOTFILES_DIR="${${(%):-%N}:A:h:h}"

if [ -f "$HOME/.config/shell/common.sh" ]; then
  . "$HOME/.config/shell/common.sh"
elif [ -f "$ZDOTFILES_DIR/shell/common.sh" ]; then
  . "$ZDOTFILES_DIR/shell/common.sh"
fi

if [ "$(uname -s)" = "Linux" ]; then
  if [ -f "$HOME/.config/shell/linux.sh" ]; then
    . "$HOME/.config/shell/linux.sh"
  elif [ -f "$ZDOTFILES_DIR/shell/linux.sh" ]; then
    . "$ZDOTFILES_DIR/shell/linux.sh"
  fi
elif [ "$(uname -s)" = "Darwin" ]; then
  if [ -f "$HOME/.config/shell/macos.sh" ]; then
    . "$HOME/.config/shell/macos.sh"
  elif [ -f "$ZDOTFILES_DIR/shell/macos.sh" ]; then
    . "$ZDOTFILES_DIR/shell/macos.sh"
  fi
fi

unset ZDOTFILES_DIR
