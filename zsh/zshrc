# ~/.zshrc: executed by zsh(1) for interactive shells.

# If not running interactively, do nothing.
[[ -o interactive ]] || return

# History
HISTSIZE=10000
SAVEHIST=20000
HISTFILE="$HOME/.zsh_history"
setopt APPEND_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_REDUCE_BLANKS
setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY

# History search with arrow keys
bindkey '^[[A' history-search-backward  # Up arrow
bindkey '^[[B' history-search-forward   # Down arrow

# History substring search plugin (if installed)
if [ -f "$HOME/.zsh/zsh-history-substring-search/zsh-history-substring-search.zsh" ]; then
  source "$HOME/.zsh/zsh-history-substring-search/zsh-history-substring-search.zsh"
  bindkey '^R' history-incremental-search-backward
  bindkey '^[[A' history-substring-search-up
  bindkey '^[[B' history-substring-search-down
fi

# Autosuggestions - show history completions as you type
if [ -f "$HOME/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh" ]; then
  source "$HOME/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh"
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=8"  # Grey color for suggestions
  ZSH_AUTOSUGGEST_STRATEGY=(history completion)
fi

# FZF history search (if installed)
if [ -f "$HOME/.fzf.zsh" ]; then
  source "$HOME/.fzf.zsh"
elif [ -f /usr/share/fzf/key-bindings.zsh ]; then
  source /usr/share/fzf/key-bindings.zsh
elif [ -f /usr/local/opt/fzf/shell/key-bindings.zsh ]; then
  source /usr/local/opt/fzf/shell/key-bindings.zsh
fi

# Completion
autoload -Uz compinit
compinit

# Shared shell setup
ZDOTFILES_DIR="${${(%):-%N}:A:h:h}"

if [ -f "$HOME/.config/shell/common.sh" ]; then
  . "$HOME/.config/shell/common.sh"
elif [ -f "$ZDOTFILES_DIR/shell/common.sh" ]; then
  . "$ZDOTFILES_DIR/shell/common.sh"
fi

if [ "$(uname -s)" = "Linux" ]; then
  if [ -f "$HOME/.config/shell/linux.sh" ]; then
    . "$HOME/.config/shell/linux.sh"
  elif [ -f "$ZDOTFILES_DIR/shell/linux.sh" ]; then
    . "$ZDOTFILES_DIR/shell/linux.sh"
  fi
elif [ "$(uname -s)" = "Darwin" ]; then
  if [ -f "$HOME/.config/shell/macos.sh" ]; then
    . "$HOME/.config/shell/macos.sh"
  elif [ -f "$ZDOTFILES_DIR/shell/macos.sh" ]; then
    . "$ZDOTFILES_DIR/shell/macos.sh"
  fi
fi

unset ZDOTFILES_DIR

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/home/solyvie/environments/miniforge3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/home/solyvie/environments/miniforge3/etc/profile.d/conda.sh" ]; then
        . "/home/solyvie/environments/miniforge3/etc/profile.d/conda.sh"
    else
        export PATH="/home/solyvie/environments/miniforge3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<
